{
  "name": "@nexus-ai/desktop",
  "version": "0.17.0",
  "private": true,
  "description": "Nexus AI desktop for Windows, macOS and Linux",
  "author": "Nexus AI contributors",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "dev": "electron .",
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "package:win": "electron-builder --config electron-builder.yml --win nsis --publish never",
    "package:mac": "electron-builder --config electron-builder.yml --mac dmg --publish never",
    "package:linux": "electron-builder --config electron-builder.yml --linux AppImage --publish never",
    "package:dir": "electron-builder --config electron-builder.yml --dir --publish never"
  },
  "dependencies": {
    "@better-auth/core": "1.7.10",
    "@better-auth/electron": "1.7.10",
    "@better-auth/utils": "0.5.0",
    "@better-fetch/fetch": "1.3.2",
    "@nexus-ai/codex-bridge": "workspace:*",
    "@nexus-ai/contracts": "workspace:*",
    "@openai/codex": "0.159.2",
    "better-auth": "1.7.10",
    "better-call": "1.4.2",
    "conf": "15.0.2",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  }
}
