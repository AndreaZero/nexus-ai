# Copy to .env only when customizing local development. Never commit .env.
NEXUS_SERVER_HOST=127.0.0.1
NEXUS_SERVER_PORT=3001
NEXUS_ALLOWED_ORIGINS=http://127.0.0.1:5173,nexus://app
# Log server: info = ogni richiesta completata; debug = anche ricezione richiesta.
# Chalk rileva i colori del terminale; NO_COLOR=1 li disattiva.
# Cookie, body, query string, token e messaggi SQL non vengono stampati.
NEXUS_LOG_LEVEL=info
# Public URL embedded by Vite at build time; never place a secret in a VITE_ variable.
VITE_NEXUS_SERVER_URL=http://127.0.0.1:3001
# T03 local PostgreSQL preparation: see docs/setup/postgresql.md.
# Create the dedicated role/database yourself; tables will come from project migrations.
# Replace PASSWORD_URL_ENCODED locally with the URL-encoded password; server-only.
# Connections are explicit; pnpm db:migrate applies reviewed migrations only to nexus_ai_dev.
# DATABASE_URL=postgresql://nexus_ai_dev:PASSWORD_URL_ENCODED@127.0.0.1:5432/nexus_ai_dev
# After DATABASE_URL is configured, pnpm auth:setup creates a private random secret
# and these local defaults without replacing existing values. Never reuse a shared secret.
# BETTER_AUTH_SECRET=<generated privately by pnpm auth:setup>
# BETTER_AUTH_URL=http://127.0.0.1:3001
# NEXUS_WEB_URL=http://127.0.0.1:3001
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false
# NEXUS_EMAIL_FROM="Nexus AI <noreply@nexus.local>"
# SMTP_USER and SMTP_PASSWORD are not needed for the loopback-only Mailpit receiver.

# Optional exact trusted reverse-proxy IP/CIDR list. Empty means no proxy trust.
# Configure only when serving behind your controlled proxy; never use true or *.
NEXUS_TRUSTED_PROXIES=
