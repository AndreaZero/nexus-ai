# Copy outside version control to deploy/self-host.env. Generate all secrets separately.
# Passwords below must be URL-safe base64url strings; do not retain these placeholders.
NEXUS_DATABASE_ADMIN_PASSWORD=
NEXUS_DATABASE_PASSWORD=
BETTER_AUTH_SECRET=
# Exact HTTPS origin on production; loopback HTTP is allowed for an isolated local install.
NEXUS_PUBLIC_URL=https://nexus.example.com
NEXUS_HTTP_PORT=3001
# Only addresses/ranges of YOUR proxy; empty means all forwarded headers are untrusted.
NEXUS_TRUSTED_PROXIES=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
NEXUS_EMAIL_FROM=Nexus AI <noreply@example.com>
NEXUS_LOG_LEVEL=info
