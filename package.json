{
  "name": "nexus-ai",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "^22.19.0 || ^24.0.0",
    "pnpm": "10.32.1"
  },
  "scripts": {
    "dev:desktop": "node scripts/workspace.mjs dev:desktop",
    "dev:web": "node scripts/workspace.mjs dev:web",
    "dev:server": "node scripts/workspace.mjs dev:server",
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --filter \"./packages/**\" build && pnpm -r --if-present typecheck && eslint . && node scripts/check-boundaries.mjs",
    "test": "pnpm -r --filter \"./packages/**\" build && pnpm -r --if-present test && node --test scripts/*.test.mjs",
    "package:win": "node scripts/workspace.mjs package:win",
    "package:mac": "node scripts/workspace.mjs package:mac",
    "package:linux": "node scripts/workspace.mjs package:linux",
    "start:desktop": "node scripts/workspace.mjs start:desktop",
    "start:server": "node scripts/workspace.mjs start:server",
    "smoke:desktop": "pnpm --filter @nexus-ai/desktop smoke",
    "verify:shell": "pnpm --filter @nexus-ai/desktop exec electron . --verify-shell",
    "db:migrate": "pnpm --filter @nexus-ai/db migrate",
    "db:check": "pnpm --filter @nexus-ai/db check:connection",
    "mailpit": "node scripts/mailpit.mjs",
    "auth:setup": "node scripts/setup-local-auth.mjs",
    "verify:accounts": "node scripts/verify-accounts.mjs",
    "verify:auth-desktop": "pnpm --filter @nexus-ai/desktop exec electron . --verify-auth",
    "verify:collaboration": "node scripts/verify-collaboration.mjs",
    "codex:prepare": "node scripts/prepare-codex.mjs",
    "verify:codex": "node scripts/verify-codex.mjs",
    "codex:schema": "node scripts/generate-codex-schema.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
